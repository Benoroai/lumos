# Public application configuration
NEXT_PUBLIC_APP_NAME=Lumos
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=tenant-media

# Server-only Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=tenant-media

# Database tooling (migrations, seed, generated types, and DB tests)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/lumos_test

# Public API and session policy
PUBLIC_API_CORS_ORIGINS=http://localhost:3000
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
PUBLIC_API_ANALYTICS_RATE_LIMIT_PER_MINUTE=240
PUBLIC_API_CACHE_SECONDS=60
PUBLIC_API_BLOCK_EXPIRED_SUBSCRIPTIONS=true
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
SESSION_IDLE_TIMEOUT_MINUTES=720
MEDIA_MAX_UPLOAD_BYTES=5242880

# Translation provider. `echo` is the offline development default.
AI_TRANSLATION_PROVIDER=echo
AI_TRANSLATION_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Used by the seed command to create the first platform administrator.
PLATFORM_SUPER_ADMIN_EMAIL=admin@lumos.local
PLATFORM_SUPER_ADMIN_PASSWORD=replace-with-a-strong-development-password
PLATFORM_SUPER_ADMIN_NAME=Platform Super Admin

